    }
   ]
  },
  {
   "name": "日志输出",
   "nodes": [
    {
     "id": "out_valid",
     "title": "正常输出",
     "sub": "取到的字段值"
    },
    {
     "id": "out_missing",
     "title": "缺失值",
     "sub": "日志中是 -"
    }
   ]
  }
 ],
 "edges": [
  {
   "from": "header",
   "to": "first_use"
  },
  {
   "from": "first_use",
   "to": "valid",
   "label": "解析成功"
  },
  {
   "from": "first_use",
   "to": "invalid",
   "label": "解析失败"
  },
  {

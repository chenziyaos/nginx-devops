{
  "type": "graph",
  "title": "后端故障后摘除、超期后权重逐步恢复",
  "subtitle": "从左到右表示后端状态转移；fail_timeout 周期内保持摘除",
  "source": "来源：ngx_stream_upstream_round_robin.c（1.31.10）",
  "stages": [
    {
      "name": "可用",
      "nodes": [
        {
          "id": "avail",
          "title": "可用",
          "sub": "effective_weight = weight",
          "tone": "good"
        }
      ]
    },
    {
      "name": "摘除",
      "nodes": [
        {
          "id": "down",
          "title": "摘除",
          "sub": "fails ≥ max_fails，ew 扣到 0；fail_timeout 内再失败留在此",
          "tone": "risk"
        }
      ]
    },
    {
      "name": "恢复中",
      "nodes": [
        {
          "id": "recover",
          "title": "恢复中",
          "sub": "参与选择，ew 每轮加 1"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "avail",
      "to": "down",
      "label": "连接失败"
    },
    {
      "from": "down",
      "to": "recover",
      "label": "超过 fail_timeout"
    },
    {
      "from": "recover",
      "to": "avail",
      "label": "被选中且成功"
    }
  ]
}

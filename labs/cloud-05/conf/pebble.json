{
  "pebble": {
    "listenAddress": "0.0.0.0:14000",
    "managementListenAddress": "0.0.0.0:15000",
    "certificate": "/etc/pebble/tls/tls.crt",
    "privateKey": "/etc/pebble/tls/tls.key",
    "httpPort": 80,
    "tlsPort": 443,
    "ocspResponderURL": "",
    "externalAccountBindingRequired": false,
    "retryAfter": {
      "authz": 3,
      "order": 5
    },
    "keyAlgorithm": "ecdsa",
    "profiles": {
      "default": {
        "description": "90 days, as Let's Encrypt",
        "validityPeriod": 7776000
      },
      "short": {
        "description": "2 minutes, so a renewal happens during the lab",
        "validityPeriod": 120
      }
    }
  }
}

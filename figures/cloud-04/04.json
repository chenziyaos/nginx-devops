  {"from": "plain", "to": "client", "text": "没有回答", "reply": true},
  {"from": "ConfigMap", "to": "web", "text": "改成正确的 v3"},
  {"from": "web", "to": "web", "text": "PATCH 200，回答 v3"},
  {"from": "plain", "to": "plain", "text": "下一次重启读到 v3，恢复"}
 ],
 "sections": [
  {"at": 0, "label": "坏配置下发"},

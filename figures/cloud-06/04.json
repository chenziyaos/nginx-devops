  {"from": "客户端", "to": "nginx", "text": "traceparent 00-T-C-01"},
  {"from": "nginx", "to": "nginx", "text": "沿用 T，父 span 记为 C，生成 N"},
  {"from": "nginx", "to": "后端 app", "text": "改写为 00-T-N-01"},

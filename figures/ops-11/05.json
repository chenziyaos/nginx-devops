{
 "type": "sequence",
 "title": "日志先进内存缓冲，flush 定时器到期后才落盘",
 "subtitle": "纵轴是时间顺序；0.2 秒时文件为空，3 秒后日志进磁盘",
 "source": "来源：ngx_http_log_module.c（1.31.9）、labs/ops-11 实验输出",
 "actors": [
  {"name": "客户端"},
  {"name": "worker"},
  {"name": "内存缓冲"},
  {"name": "buf.log"}
 ],
 "messages": [
  {
   "from": "客户端",
   "to": "worker",
   "text": "GET /buf"
  },
  {
   "from": "worker",
   "to": "内存缓冲",
   "text": "写入第一行，启动 3 秒 flush 定时器"
  },
  {
   "from": "worker",
   "to": "buf.log",
   "text": "0.2 秒时文件为空；3.5 秒时定时器到期，write 落盘"
  }
 ],
 "sections": []
}

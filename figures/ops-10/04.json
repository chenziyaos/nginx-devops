  ["②", "Cache-Control", "private、no-cache、no-store 或 max-age=0", {"text": "不存", "tone": "risk"}],
  ["③", "Cache-Control", "s-maxage 或 max-age", "有效期 = s-maxage，没有就用 max-age"],
  ["④", "Expires", "在未来", "有效期 = Expires"],
  ["⑤", "proxy_cache_valid", "覆盖这个状态码", "有效期 = 配置值"],

   "nodes": [
    {
     "id": "header",
     "title": "$http_x_ctx",
     "sub": "请求头里的 JSON"
    }
   ]
  },
  {
   "name": "判断是否需要解析",
   "nodes": [
    {
     "id": "first_use",
     "title": "第一次使用",
     "sub": "$tenant 或 $first_item",
     "tone": "main",
     "emph": true
    }
   ]
  },
  {
   "name": "解析结果",
   "nodes": [
    {
